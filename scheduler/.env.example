# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL (shared via china-model)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=deal-library
DATABASE_USER=doadmin
DATABASE_PASSWORD=changeme

# Qiniu object storage (used by docToCloud and the archive job)
QINIU_ACCESS_KEY=changeme
QINIU_SECRET_KEY=changeme
QINIU_BUCKET=deal-docs
QINIU_BUCKET_DOMAIN=deal-doc.doclink.site

# MinerU batch API (processMineruQueue / catchUpPdf)
MINERU_TOKEN=changeme
MINERU_CALLBACK=http://101.132.150.211:5000/process-mineru
MINERU_CALLBACK_CHECK=http://101.132.150.211:5000/index

# pgmq queue connection (defaults to the DATABASE_* settings above)
#PGMQ_HOST=localhost

# Local staging folder for downloaded documents
#DOCS_DIR=./docs

# Log directory for the rotating scheduler.log
#SCHEDULER_LOG_DIR=./logs
