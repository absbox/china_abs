# toMarkdown — task runner (just)
#
# Run from this folder:  just <recipe>

set shell := ["bash", "-cu"]

dir := justfile_directory()
py := dir + "/../.venv/bin/python"

# Show available recipes
default:
    @just --list

# Enter this project's nix shell
shell:
    cd {{dir}} && nix-shell shell.nix

# List PDFs still missing markdown
list:
    cd {{dir}} && {{py}} main.py list

# ---------------------------------------------------------------------------
# Fallback pipeline: pdf-inspector -> paddle -> mineru
# ---------------------------------------------------------------------------

# Convert a list of PDF names, escalating engines until each is converted.
# e.g. `just process "a.pdf" "b.pdf"`
process +names:
    cd {{dir}} && {{py}} main.py process {{names}}

# Convert every outstanding PDF through the fallback pipeline
process-all:
    cd {{dir}} && {{py}} main.py process

# ---------------------------------------------------------------------------
# Individual engines
# ---------------------------------------------------------------------------

# pdf-inspector: download key(s) then convert docs/
pdfinspect +names:
    cd {{dir}} && for n in {{names}}; do {{py}} main.py download "$n"; done
    cd {{dir}} && {{py}} main.py inspect

# pdf-inspector: download and convert every outstanding PDF
pdfinspect-all:
    cd {{dir}} && {{py}} main.py download-all
    cd {{dir}} && {{py}} main.py inspect

# PaddleOCR-VL: download key(s) then convert docs/ one by one
paddle +names:
    cd {{dir}} && for n in {{names}}; do {{py}} main.py download "$n"; done
    cd {{dir}} && {{py}} main.py paddle docs

# PaddleOCR-VL: download and convert every outstanding PDF
paddle-all:
    cd {{dir}} && {{py}} main.py download-all
    cd {{dir}} && {{py}} main.py paddle docs

# MinerU: convert specific Qiniu key(s) (no download needed)
mineru +names:
    cd {{dir}} && for n in {{names}}; do {{py}} main.py mineru -k "$n"; done

# MinerU: convert every outstanding Qiniu file
mineru-all:
    cd {{dir}} && {{py}} main.py mineru

# MinerU: convert local PDFs in docs/
mineru-docs:
    cd {{dir}} && {{py}} main.py mineru docs

# ---------------------------------------------------------------------------
# Backwards-compatible aliases
# ---------------------------------------------------------------------------

alias convert := pdfinspect
alias convert-all := pdfinspect-all
alias convert-list := list
