# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection (used by china_model.configure())
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=deal-library
DATABASE_USER=doadmin
DATABASE_PASSWORD=changeme

# Optional full DSN; when set it takes precedence and is also what the
# opencode postgres MCP server references (opencode.json uses {env:DATABASE_URI}).
#DATABASE_URI=postgresql://doadmin:changeme@localhost:5432/deal-library

# Optional LLM / MongoDB credentials (used by other monorepo components)
#QWEN_API_KEY=
#MONGODB_URI=mongodb://localhost:27017
