{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "postgres": {
      "type": "local",
      "command": [
        "/home/xiaoyu/.local/bin/postgres-mcp",
        "--access-mode=restricted"
      ],
      "enabled": true,
      "environment": {
        "DATABASE_URI": "{env:DATABASE_URI}"
      }
    },
    "mongodb": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mongodb-mcp-server@latest",
        "--readOnly"
      ],
      "enabled": true,
      "environment": {
        "MDB_MCP_CONNECTION_STRING": "{env:MONGODB_URI}"
      }
    }
  }
}
