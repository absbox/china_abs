# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL (shared via china-model)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=deal-library
DATABASE_USER=doadmin
DATABASE_PASSWORD=changeme

# Qiniu object storage (docToCloud, toMarkdown, archive)
QINIU_ACCESS_KEY=changeme
QINIU_SECRET_KEY=changeme
QINIU_BUCKET=deal-docs
QINIU_BUCKET_DOMAIN=deal-doc.doclink.site

# MinerU batch API (scheduler)
MINERU_TOKEN=changeme
MINERU_CALLBACK=http://101.132.150.211:5000/process-mineru
MINERU_CALLBACK_CHECK=http://101.132.150.211:5000/index

# MongoDB (digester structured extractions)
MONGODB_URI=mongodb://localhost:27017

# LLM providers (digest); one key per provider, LLM_API_KEY is a fallback
QWEN_API_KEY=changeme
DEEPSEEK_API_KEY=changeme
LLM_API_KEY=changeme
LLM_MODEL_NAME=
