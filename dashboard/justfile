# china-abs dashboard — status / health checks (just)
#
# The dashboard is read-only: it reports on the health of the whole project.
# Actions live with the component that owns the underlying function; run `just`
# from that component's folder instead (docToCloud, toMarkdown, scheduler,
# digester, reader, absbox.cloud).
#
# Run from this folder:  cd dashboard && just <recipe>

set shell := ["bash", "-cu"]

dash := justfile_directory()
py := dash + "/../.venv/bin/python"

# Show available recipes
default:
    @just --list

# Health-check the whole china-abs project (DB + outstanding work + config)
health:
    @{{py}} {{dash}}/main.py health
