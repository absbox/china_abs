# PostgreSQL (remote, read-only client)
export APP_POSTGRESQL__HOST=remote.example.com
export APP_POSTGRESQL__PORT=5432
export APP_POSTGRESQL__DATABASE=reader
export APP_POSTGRESQL__USER=postgres
export APP_POSTGRESQL__PASSWORD=yourpassword
export APP_POSTGRESQL__SSLMODE=require
export APP_POSTGRESQL__TABLE_NAME=markdown_files
export APP_POSTGRESQL__COLUMN_NAME=content
export APP_POSTGRESQL__ID_COLUMN=id

# MongoDB (internal storage for LLM/instructor JSON results)
export APP_MONGODB__URI=mongodb://localhost:27017
export APP_MONGODB__DATABASE=reader
export APP_MONGODB__COLLECTION=extracted_documents

# LLM provider (any OpenAI-compatible endpoint)
export APP_LLM__PROVIDER=openai
export APP_LLM__MODEL=gpt-4o
export APP_LLM__API_KEY=your-api-key-here
# export APP_LLM__BASE_URL=http://localhost:11434/v1  # Local providers (e.g. Ollama)

# Process up to N records per run (omit for all)
# export APP_FETCH_LIMIT=100